FROM python:3.10-slim

WORKDIR /app

# Install pymysql for database connectivity
RUN pip install --no-cache-dir pymysql

# Copy the daemon script
COPY modules/logmanage/syslog_receiver.py .

# Create the logs directory
RUN mkdir -p /var/log/janus_siem && chmod 755 /var/log/janus_siem

# Expose Syslog UDP port
EXPOSE 514/udp

# Run the daemon
CMD ["python", "syslog_receiver.py"]
